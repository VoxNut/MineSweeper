@startuml
skinparam defaultFontName "Arial"
skinparam backgroundcolor transparent
skinparam style strictuml

' Clean, minimal monochrome style
skinparam ArrowColor #000000
skinparam ActorBorderColor #000000
skinparam ActorBackgroundColor #FFFFFF
skinparam LifeLineBorderColor #000000
skinparam LifeLineBackgroundColor #FFFFFF
skinparam ParticipantBorderColor #000000
skinparam ParticipantBackgroundColor #FFFFFF
skinparam BoxBorderColor #000000
skinparam BoxBackgroundColor transparent
skinparam NoteBorderColor #000000
skinparam NoteBackgroundColor #FFFFFF
skinparam GroupBorderColor #000000
skinparam GroupBackgroundColor transparent
skinparam GroupHeaderBackgroundColor #FFFFFF

title UC-2: Đăng nhập bằng Email và Password (Sequence Diagram)

box "Client / Frontend"
actor "Người dùng\n(Player/Admin)" as User
participant "Frontend" as FE
end box

box "Firebase / Google"
participant "Firebase SDK" as AuthSDK
end box

box "Server / Backend"
participant "Backend\n(/auth/login)" as BE
participant "Firebase Admin SDK" as AdminSDK
database "Firestore" as DB
end box

autonumber stop

== 2.1 Basic Flow: Đăng nhập Email/Password ==

User -> FE : 2.1.1: Nhập Email, Password và kích hoạt đăng nhập
activate FE

FE -> FE : 2.1.2: Validate dữ liệu đầu vào

alt 2.4 Luồng ngoại lệ: Nhập thiếu dữ liệu
    note over FE : Phát hiện Email hoặc Password bị bỏ trống
    FE -> User : 2.4.2: Hiển thị dòng thông báo lỗi dưới ô nhập liệu
    note over FE : 2.4.3: Dừng tiến trình đăng nhập
else Dữ liệu hợp lệ
    FE -> AuthSDK : 2.1.3: Gọi signInWithEmailAndPassword(email, password)
    activate AuthSDK

    alt 2.5 Luồng ngoại lệ: Sai thông tin đăng nhập
        AuthSDK --> FE : 2.5.1: Báo lỗi xác thực (Invalid credentials)
        FE -> User : 2.5.2: Hiển thị cảnh báo "Email login failed"
        note over FE : 2.5.3: Dừng tiến trình đăng nhập
    else Xác thực thành công
        AuthSDK --> FE : 2.1.4: Xác thực thành công và trả về UserInfo
        deactivate AuthSDK

        FE -> AuthSDK : 2.1.5: Yêu cầu cấp idToken
        activate AuthSDK
        AuthSDK --> FE : Trả về idToken (JWT)
        deactivate AuthSDK

        FE -> BE : 2.1.6: Gửi API POST kèm idToken
        activate BE

        BE -> AdminSDK : 2.1.7: Gọi Firebase Admin để verify idToken
        activate AdminSDK

        alt 2.6 Luồng ngoại lệ: Lỗi Token
            AdminSDK --> BE : 2.6.1: Báo lỗi token không hợp pháp hoặc hết hạn
            deactivate AdminSDK
            BE --> FE : 2.6.2: Trả về HTTP status 500 Internal Server Error
            FE -> User : 2.6.3: Hiển thị cảnh báo "Login failed"
            note over FE : 2.6.4: Dừng tiến trình đăng nhập
        else Token hợp lệ
            BE -> AdminSDK : Trích xuất dữ liệu định danh
            activate AdminSDK
            AdminSDK --> BE : 2.1.8: Trả về uid và các thông tin định danh khác
            deactivate AdminSDK

            BE -> DB : 2.1.9: Tìm kiếm bản ghi User trong Firestore qua UserDAO
            activate DB
            DB --> BE : Kết quả truy vấn
            deactivate DB

            alt 2.1.10: Tài khoản đã tồn tại trên Firestore
                BE -> BE : 2.1.10: Cập nhật trường lastLoginAt
            else 2.2 Luồng thay thế: Tài khoản lần đầu đăng nhập hệ thống
                BE -> BE : 2.2.1: Phát hiện chưa có bản ghi User nào khớp uid
                BE -> BE : 2.2.2: Tạo mới đối tượng User (role="player", elo=1000)
            end

            BE -> DB : 2.1.11: Lưu (upsert) bản ghi User vào Firestore
            activate DB
            DB --> BE : Phản hồi thành công
            deactivate DB

            alt 2.7 Luồng ngoại lệ: Tài khoản bị cấm
                BE -> BE : 2.7.1: Phát hiện thuộc tính blocked = true của User
                BE --> FE : 2.7.2: Trả về HTTP status 403 Forbidden
                FE -> User : 2.7.3: Hiển thị cảnh báo "User is blocked"
                note over FE : 2.7.4: Dừng tiến trình đăng nhập
            else Tài khoản hợp lệ (blocked = false)
                BE -> BE : 2.1.12: Khởi tạo đối tượng HttpSession và gán uid, role...
                BE --> FE : 2.1.13: Phản hồi HTTP 200 OK kèm thuộc tính role
                deactivate BE

                alt 2.3 Luồng xử lý phân quyền điều hướng (2.1.14)
                    alt 2.3.1 Role là "admin"
                        FE -> User : 2.3.1.1: Chuyển hướng người dùng đến URL /admin/users
                    else 2.3.2 Role là "player"
                        FE -> User : 2.3.2.1: Chuyển hướng người dùng đến URL /game
                    end
                end
                deactivate FE
            end
        end
    end
end

@enduml
